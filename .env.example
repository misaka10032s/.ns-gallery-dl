# ============================================================
#  .env.example  —  copy this file to .env and fill in values
# ============================================================

# ── Discord Bot ──────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Required intents: Message Content Intent (enabled in Bot settings)

# Your bot token (keep this secret!)
DISCORD_BOT_TOKEN=your_bot_token_here

# Comma-separated list of channel IDs to monitor for images / links
# Right-click a channel in Discord → "Copy Channel ID" (needs Developer Mode enabled)
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# Optional domain filters for the bot URL monitor.
# Leave empty to allow all built-in supported domains.
# BOT_DOMAIN_ALLOWLIST=pixiv.net,nhentai.net,x.com
# BOT_DOMAIN_DENYLIST=facebook.com
BOT_DOMAIN_ALLOWLIST=
BOT_DOMAIN_DENYLIST=

# ── Reaction Emojis ──────────────────────────────────────────
# Reactions added to messages when the bot processes them.
# Supports unicode emoji or custom emoji in <:name:id> or <a:name:id> format.
# If a custom emoji fails (no permission / wrong server), the bot falls back to the defaults.
#
# Default:  ⏳  →  ✅  (or ❌ on failure)
#
# Examples:
#   DISCORD_EMOJI_QUEUED=<:loading:1234567890123456789>
#   DISCORD_EMOJI_DONE=<:check:1234567890123456789>
#   DISCORD_EMOJI_FAILED=<a:error:1234567890123456789>   ← animated emoji

DISCORD_EMOJI_QUEUED=⏳
DISCORD_EMOJI_DONE=✅
DISCORD_EMOJI_FAILED=❌

# ── wnacg failure alert ──────────────────────────────────────
# After this many CONSECUTIVE wnacg download failures (across web UI, queue,
# and bot — any trigger), one Discord message is posted to DISCORD_CHANNEL_IDS
# via DISCORD_BOT_TOKEN (reuses the two Discord settings above; the bot process
# itself does NOT need to be running — direct REST call). A single transient
# failure never alerts; only one alert fires per outage until a success resets it.
WNACG_ALERT_THRESHOLD=3

# ── Web UI security (待回答 #47) ──────────────────────────────
# Port the local API server binds (app/api/app.py run_server()). Change this
# ONLY if you also change how you launch the server — the Origin/Host guard
# (app/api/origin_guard.py) reads this SAME value, so a mismatch here would
# make the guard reject every legitimate request instead of accepting them.
# NS_MEDIA_HUB_PORT=7601

# Extra Origins the Origin/Host guard should accept on top of its built-in
# loopback + Vite-dev-port allow-list, comma-separated. Each entry must be an
# exact `scheme://host[:port]` with no path — a wildcard entry is dropped
# with a startup WARNING rather than silently accepted or rejected outright.
# NS_MEDIA_HUB_EXTRA_ORIGINS=http://127.0.0.1:5174

# This repo's own chromeExtension/ (a legitimate first-party client, not a
# browser page) sends `Origin: chrome-extension://<extension-id>` on every
# POST to the local API — NOT allowed by default (a blanket
# chrome-extension:// scheme allow would admit every extension installed in
# your browser, not just this one). To let it through, add ONE concrete
# entry here with your installed extension's own id — never a wildcard.
# Find the id: open chrome://extensions, enable 開發人員模式 (Developer mode)
# in the top-right, then read the "ID" field under this extension's card
# (32 lowercase letters a-p).
# NS_MEDIA_HUB_EXTRA_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# ── Cookie Management ────────────────────────────────────────
# Put Netscape-format cookie files in one of these locations:
#   data/cookies/
#   module/cookies/      (legacy-compatible)
#   cookies/             (legacy-compatible)
#
# Naming recommendations:
#   cookies-pixiv-net.txt
#   cookies-fanbox-cc.txt
#   x.com_cookies.txt
