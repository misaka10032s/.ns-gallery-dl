{
  "name": "NS Media Hub",
  "version": "2.1.0",
  "description": "Unified downloader and browser helper for NS Media Hub.",
  "manifest_version": 3,
  "author": "misaka10032s",
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "downloads",
    "notifications",
    "webRequest",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:7601/*",
    "http://*/*",
    "https://*/*",
    "https://app-api.pixiv.net/*",
    "https://www.pixiv.net/*",
    "https://accounts.pixiv.net/*"
  ],
  "action": {
    "default_popup": "static/template/popup/action_popup_index.html"
  },
  "omnibox": {
    "keyword": "ns"
  },
  "icons": {
    "16": "static/images/icon16.png"
  },
  "commands": {
    "Ctrl+Shift+Z": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "MacCtrl+Shift+Z"
      },
      "description": "NS Media Hub command"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/users/*",
        "https://www.pixiv.net/artworks/*"
      ],
      "js": [
        "static/module/selector.js",
        "pixiv/content.js"
      ],
      "css": [
        "static/module/selector.css",
        "pixiv/style.css"
      ]
    },
    {
      "matches": [
        "https://nhentai.net/*",
        "https://nhentai.net/g/*"
      ],
      "js": [
        "static/module/selector.js",
        "nhentai/content.js"
      ],
      "css": [
        "static/module/selector.css",
        "nhentai/style.css"
      ]
    },
    {
      "matches": [
        "https://wnacg.com/*",
        "https://www.wnacg.com/*"
      ],
      "js": [
        "static/module/selector.js",
        "wnacg/content.js"
      ],
      "css": [
        "static/module/selector.css",
        "wnacg/style.css"
      ]
    },
    {
      "matches": [
        "https://yande.re/post",
        "https://yande.re/post?tags=*"
      ],
      "js": [
        "static/module/selector.js",
        "yande.re/content.js"
      ],
      "css": [
        "static/module/selector.css",
        "yande.re/style.css"
      ]
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "static/module/selector.js",
        "facebook/content.js"
      ],
      "css": [
        "static/module/selector.css",
        "facebook/style.css"
      ]
    }
  ]
}
